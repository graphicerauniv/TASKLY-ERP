NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=Taskly ERP
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=8h
CORS_ORIGINS=http://localhost:4200

# Razorpay Checkout. Payments stay disabled until both keys are configured.

# Object storage. Keep "local" until S3 credentials are configured.
# Supabase endpoint: https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# AWS S3: leave S3_ENDPOINT empty and set S3_FORCE_PATH_STYLE=false.
STORAGE_DRIVER=local
S3_BUCKET=admission-uploads
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Public bucket/CDN base URL, without a trailing slash. Optional for private buckets.
S3_PUBLIC_URL=

# Optional one-time bootstrap. This account is inserted into PostgreSQL and its
# password is hashed. Remove these values after the first successful start.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
