NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=Taskly ERP
MONGODB_URL=mongodb://127.0.0.1:27017/taskly_erp
MONGODB_DB_NAME=taskly_erp
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=8h
CORS_ORIGINS=http://localhost:4200
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Optional one-time bootstrap. This account is inserted into MongoDB and its
# password is hashed. Remove these values after the first successful start.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
