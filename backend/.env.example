NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
APP_NAME=Taskly ERP API

DATABASE_URL=postgresql://taskly:change_me@localhost:5432/taskly_erp
MONGODB_URL=mongodb://localhost:27017/taskly_erp
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
OPENSEARCH_NODE=http://localhost:9200

JWT_ACCESS_SECRET=replace_with_at_least_64_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_64_character_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
S3_BUCKET=taskly-erp

CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=info
